# SQL style for the dbt project. Enforced by pre-commit; `sqlfluff fix` applies
# most of it automatically.
[sqlfluff]
# jinja, not dbt: linting only needs to PARSE the SQL, and the dbt templater
# insists on opening a real DuckDB connection - whose relative profile paths
# resolve against sqlfluff's CWD, not transform/, so it breaks from the repo
# root where pre-commit runs. apply_dbt_builtins supplies ref/source/var/config.
templater = jinja
dialect = duckdb
max_line_length = 100
# LT05 (long lines) is left on, but comment-only overruns are tolerated below.
# RF01  - sqlfluff cannot resolve {{ ref() }} targets, so its column-existence
#         check is all false positives.
# ST06   - opinionated SELECT-target ordering; not worth churn.
# AL06   - single-letter table aliases (p, d, s, v) are idiomatic dbt.
# ST07   - USING(player_id) is clearer than a repeated ON for shared keys.
exclude_rules = RF01, ST06, AL06, ST07

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

# Project macros sqlfluff must know about to parse the models. Keep in step
# with transform/macros/ - a stub only has to produce parseable SQL.
[sqlfluff:templater:jinja:macros]
season_of = {% macro season_of(date_col) %}CASE WHEN EXTRACT(MONTH FROM {{ date_col }}) >= 7 THEN EXTRACT(YEAR FROM {{ date_col }}) ELSE EXTRACT(YEAR FROM {{ date_col }}) - 1 END{% endmacro %}

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false
indented_using_on = true
template_blocks_indent = false

# ---- capitalisation: SQL keywords SHOUT, our identifiers stay lower_snake ----
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

# ---- aliasing: always explicit, never the column-alignment padding we had ----
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
