# Copy to .env before the first `docker compose up`.
#
# AIRFLOW_UID must match your host user, or every file the pipeline writes into
# data/ is owned by root and the Streamlit app cannot read it. On macOS/Linux:
#     echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=501

# No login: the stack binds to localhost only and Airflow 3's SimpleAuthManager
# is set to treat every visitor as admin. Fine here, never anywhere reachable.

# Shared between the scheduler (signs) and apiserver (verifies). Any string works
# locally; generate a real one with `openssl rand -hex 32` if this is ever exposed.
AIRFLOW_JWT_SECRET=local-dev-not-a-real-secret
